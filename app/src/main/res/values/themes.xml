<resources>
    <!-- Thin XML shell — the real theme lives in Compose (ui/theme/Theme.kt) -->
    <style name="Theme.FloraLens" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/cream</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.FloraLens.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#F7FAF2</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.FloraLens</item>
    </style>
</resources>
